# Copy to deploy/.env.production on the VPS, then replace every placeholder.
# Never commit deploy/.env.production.
KANJIAI_DB_PATH=/data/kanjiai.db
KANJIAI_CORS_ORIGINS=https://kanjiai.example.com
KANJIAI_APP_URL=https://kanjiai.example.com
KANJIAI_SESSION_DAYS=30

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://kanjiai.example.com/auth/google/callback

# Generate a random value of at least 32 characters, for example:
# openssl rand -hex 32
KANJIAI_ADMIN_API_KEY=replace-with-a-long-random-secret

# Create a remotely-managed Cloudflare Tunnel in the dashboard. Copy only its
# token (the value beginning eyJ...) here; never commit or share it.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token