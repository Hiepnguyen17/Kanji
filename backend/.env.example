# Các origin frontend được phép gọi API, phân cách bằng dấu phẩy.
KANJIAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth: tạo Web application OAuth client trong Google Cloud Console.
# Không commit client secret thật vào Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8010/auth/google/callback
KANJIAI_APP_URL=http://localhost:5173
KANJIAI_SESSION_DAYS=30

# Bắt buộc khi dùng các API /admin/*. Tạo chuỗi ngẫu nhiên dài (ít nhất 32 ký tự)
# và chỉ lưu trong backend/.env hoặc secret manager của máy chủ.
KANJIAI_ADMIN_API_KEY=
